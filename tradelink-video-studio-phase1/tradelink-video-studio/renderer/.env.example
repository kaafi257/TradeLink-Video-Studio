# Copy this file to ".env" in the renderer folder and fill in the values. NEVER commit ".env".
# Use the Studio's own Supabase project. Only the PUBLISHABLE (anon) key goes here; a service-role or secret key is refused.
STUDIO_SUPABASE_URL=https://your-studio-project.supabase.co
STUDIO_SUPABASE_PUBLISHABLE_KEY=
# The dedicated renderer login you created in Supabase (see docs/WINDOWS-RENDERER.md)
RENDERER_EMAIL=
RENDERER_PASSWORD=
# Optional: full paths if ffmpeg/ffprobe are not on your PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional: seconds to wait between checks when there is nothing to render (default 15)
POLL_SECONDS=15
# Optional local AI wording (Ollama on THIS computer). Leave OLLAMA_MODEL empty to keep AI off.
# Never point OLLAMA_URL anywhere except this computer. Installing Ollama is optional and is your decision.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
# Optional brand logo (shown top-left instead of the plain "TradeLink" text) and background sound.
# Use files YOU own or have the right to use. Put them anywhere on this computer and give the full path, for example:
# BRAND_LOGO=C:\\brand\\logo.png        AUDIO_FILE=C:\\brand\\music.mp3
BRAND_LOGO=
AUDIO_FILE=
AUDIO_VOLUME=0.5
# Closing frame: the last second fades to the brand colour and shows your logo (or the TradeLink name). Set to off to disable.
CLOSING_FRAME=on
# Video quality: high (default, slower, sharper) or fast (quicker, slightly softer).
RENDER_QUALITY=high
